# CtYunKeeper Windows 运行配置
# 修改后重新运行 start.bat 生效；等号两侧不要添加空格。

# Web 管理页面监听端口。
# 默认访问地址：http://127.0.0.1:9845
APP_PORT=9845

# 数据保存目录，用于存放数据库、登录密钥和日志。
CTYUN_DATA_DIR=data

# Web 页面静态资源目录。
CTYUN_STATIC_DIR=static

# 图形验证码识别服务地址。
# 登录被平台要求输入图形验证码时使用，留空会采用程序内置的默认地址。
OCR_ENDPOINT=https://orc.1999111.xyz/ocr

# 是否为管理页面的登录 Cookie 启用 Secure 属性。
# 直接使用 HTTP 访问时保持 false；通过 HTTPS 反向代理访问时建议改为 true。
WEB_SECURE_COOKIE=false

# 程序时区，影响 Cron 任务执行时间、日志时间和每日任务状态判断。
# 中国大陆通常保持 Asia/Shanghai。
TZ=Asia/Shanghai
