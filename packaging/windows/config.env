# CtYunKeeper Windows 运行配置
# 修改后重新运行 start.bat 生效；等号两侧不要添加空格。

# Web 管理页面监听端口。
# 默认访问地址：http://127.0.0.1:9845
APP_PORT=9845

# 数据保存目录，用于存放数据库、登录密钥和日志。
CTYUN_DATA_DIR=data

# Web 页面静态资源目录。
CTYUN_STATIC_DIR=static

# 图形验证码识别服务地址。
# 登录被平台要求输入图形验证码时使用，留空会采用程序内置的默认地址。
OCR_ENDPOINT=https://orc.1999111.xyz/ocr

# 是否为管理页面的登录 Cookie 启用 Secure 属性。
# 直接使用 HTTP 访问时保持 false；通过 HTTPS 反向代理访问时建议改为 true。
WEB_SECURE_COOKIE=false

# 程序时区，影响 Cron 任务执行时间、日志时间和每日任务状态判断。
# 中国大陆通常保持 Asia/Shanghai。
TZ=Asia/Shanghai

# 在线更新后的启动方式。
# start.bat 用户保持 self；auto 自动识别服务；服务托管也可明确设置 supervisor。
UPDATE_RESTART_MODE=self

# GitHub 下载代理；管理页面保存的值优先，在管理页面清空后使用直连。
# 支持前缀代理或带 {url} 的占位符格式。
GITHUB_PROXY=https://gh-proxy.com/

# 仅自行编译的开发版需要：填写正式发布签名使用的 Base64 Ed25519 公钥。
# 正式发布包已内置公钥，并会忽略此配置。
CTYUN_UPDATE_PUBLIC_KEY=

# Windows 服务名；auto 通常可根据主进程及父进程自动识别。
UPDATE_SERVICE_NAME=
